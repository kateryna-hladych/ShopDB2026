<Window x:Class="ShopDB2026.WPF.PasswordRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Відновлення пароля" Height="680" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Grid>
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>

                <TextBlock Text="Відновлення" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Задайте новий пароль" Style="{StaticResource SubtitleText}"/>

                <TextBlock Text="Логін" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding UsernameError}" Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Новий пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pwdNew" PasswordChanged="PwdNew_PasswordChanged"/>
                <TextBlock Text="{Binding PasswordError}" Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Підтвердження пароля" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pwdConfirm" PasswordChanged="PwdConfirm_PasswordChanged"/>
                <TextBlock Text="{Binding ConfirmError}" Style="{StaticResource ErrorText}"/>

                <TextBlock Text="{Binding Message}" Style="{StaticResource ErrorText}" MinHeight="20"/>

                <Button Content="Змінити пароль"
                        Command="{Binding ResetCommand}"
                        IsDefault="True"
                        Height="42" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>