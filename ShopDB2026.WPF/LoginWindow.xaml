
<Window x:Class="ShopDB2026.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація" Height="600" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Grid>
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>

                <TextBlock Text="Авторизація" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Магазин техніки" Style="{StaticResource SubtitleText}"/>

                <TextBlock Text="Логін" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLogin" Margin="0,0,0,16"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pwdPassword" Margin="0,0,0,8"
                             PasswordChanged="PwdPassword_PasswordChanged"/>

                <TextBlock Text="Забули пароль?"
                           Style="{StaticResource LinkText}"
                           Margin="0,0,0,8"
                           MouseDown="TxtForgotPassword_MouseDown"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           MinHeight="36" Margin="2,0,0,8"/>

                <Button x:Name="BtnLogin" Content="Увійти"
                        Command="{Binding LoginCommand}"
                        IsDefault="True"
                        Height="42" Margin="0,0,0,10"/>

                <Button Content="Зареєструватися"
                        Click="BtnRegister_Click"
                        Style="{StaticResource OutlineButton}"
                        Height="42" Margin="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>