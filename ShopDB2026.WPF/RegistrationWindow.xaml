<Window x:Class="ShopDB2026.WPF.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація" Height="600" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">

    <Grid>
        <Border Style="{StaticResource CardPanel}">
            <StackPanel>

                <TextBlock Text="Реєстрація" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Створіть обліковий запис" Style="{StaticResource SubtitleText}"/>

                <TextBlock Text="Логін" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtRegLogin"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding UsernameError}" Style="{StaticResource ErrorText}"/>

                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="pwdRegPassword"
                             PasswordChanged="PwdRegPassword_PasswordChanged"/>
                <TextBlock Text="{Binding PasswordError}" Style="{StaticResource ErrorText}"/>

                <TextBlock Text="{Binding Message}" Style="{StaticResource ErrorText}" MinHeight="20"/>

                <Button Content="Зареєструватися"
                        Command="{Binding RegisterCommand}"
                        IsDefault="True"
                        Height="42" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>